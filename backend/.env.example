# 이 파일을 backend/.env 로 복사해 실제 값을 채운다.
# .env 는 .gitignore 에 걸려 있어 커밋되지 않는다.
#
#   cp .env.example .env
#   $EDITOR .env
#   source scripts/load-env.sh

# --- 필수 ---

# OpenAI. 에이전트 대화에만 쓰인다 — 테스트·ETL·CLI 랭킹은 이 키 없이 동작한다.
# 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- 선택 ---

# Google Maps (Aggregate + Places API).
# 비워두면 load-env.sh 가 gcloud 로 자동 조회한다 — 그 편이 안전하다.
# 디스크에 평문으로 남지 않고, 키를 회전해도 그대로 동작한다.
GOOGLE_MAPS_API_KEY=

# 国土交通省 不動産情報ライブラリ (지표 13 시세, 14 재해위험, 11 보육 교체 후보).
# 발급: https://www.reinfolib.mlit.go.jp/ 신청 후 메일로 전달된다.
# 요청 시 Ocp-Apim-Subscription-Key 헤더로 보낸다.
# 미설정이면 해당 지표는 결측(percentile 50)으로 남는다 — 파이프라인은 정상 동작한다.
MLIT_API_KEY=

# 비용 보호 (스펙 §9). 비워두면 코드 기본값을 쓴다.
CHIKA_RATE_PER_MIN=6
CHIKA_DAILY_CAP=200

# API 서버 바인딩
CHIKA_HOST=127.0.0.1
CHIKA_PORT=8000

# CORS 허용 출처 (쉼표 구분). 와일드카드를 쓰지 않는다 — 공개되면 누구나
# 이 API 를 자기 사이트에서 호출할 수 있고 그 비용은 우리 청구서로 온다.
CHIKA_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
